NODE_ENV=development
PORT=4000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Phase 4 (DB optimization): tune the pool for your deployment via query
# params — e.g. connection_limit=10&pool_timeout=20. Behind PgBouncer in
# transaction mode, add &pgbouncer=true and set connection_limit=1.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edumanage?schema=public&connection_limit=10&pool_timeout=20"

# Logs any Prisma query slower than this many ms (development only).
SLOW_QUERY_THRESHOLD_MS=200

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - main platform domain + wildcard tenant subdomains
CORS_MAIN_DOMAIN=edumanage.ug
CORS_DEV_ORIGIN=http://lvh.me:5173

# Password reset
RESET_CODE_EXPIRES_MIN=15

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# 32-byte key (64 hex chars) used to encrypt integration secrets at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# ── Mail (self-hosted SMTP — no third-party email platforms) ──
MAIL_MAILER=smtp
MAIL_HOST=mail.kyakabi.com
MAIL_PORT=465
MAIL_USERNAME=a.ddumba@kyakabi.com
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=a.ddumba@kyakabi.com
MAIL_FROM_NAME="EduManage Uganda"

# ── Pesapal (API 3.0) — production payment gateway ──
# Sandbox base: https://cybqa.pesapal.com/pesapalv3
# Live base:    https://pay.pesapal.com/v3
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=change_me
PESAPAL_CONSUMER_SECRET=change_me
# Must be publicly reachable — Pesapal calls these with no auth of any kind.
PESAPAL_IPN_URL=http://localhost:4000/api/v1/payments/pesapal/ipn
PESAPAL_CALLBACK_URL=http://localhost:5173/payment/callback

